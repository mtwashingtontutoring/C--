{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and run current file",
            "type": "shell",
            "command": "g++ -std=c++20 -Wall -Wextra -g '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
